---
import { getCollection } from "astro:content";

const authors = await getCollection("authors");
console.log("length",authors.length)
---

<h1>Authors</h1>

<p>Total Authors: {authors.length}</p>

{
  authors.map((author) => (
    <div>
      <a href={`/authors/${author.id}`}>
        <h2>{author.data.name}</h2>
      </a>

      <p>{author.data.bio}</p>
    </div>
  ))
}