---
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <title>{title}</title>

    <style>
      body {
        font-family: sans-serif;
        background: #0a0a0a;
        color: white;
        margin: 0;
        padding: 40px;
      }

      a {
        color: #ff4d4d;
        text-decoration: none;
      }

      .grid {
        display: grid;
        grid-template-columns:
          repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
      }

      .card {
        border: 1px solid #222;
        border-radius: 16px;
        padding: 20px;
        background: #111;
      }
    </style>
  </head>

  <body>
    <slot />
  </body>
</html>---
